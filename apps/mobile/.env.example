# Copy this file to .env in this directory (apps/mobile/.env) if you want
# to override the API base URL without exporting a shell variable each
# time. .env is gitignored; Expo's CLI loads it automatically (no extra
# package needed) whenever you run `npm start` / `moon run mobile:start`.
#
# Only needed when the default (http://localhost:3000, set in
# src/api/client.ts) is wrong for your setup -- e.g. testing on an Android
# emulator or a physical device, which can't reach your machine via
# "localhost" and need your machine's LAN IP instead.
EXPO_PUBLIC_API_URL=http://192.168.10.128:3000

# Consumed by the QUIC driver (src/transport/quic.ts). Only needed if the
# API's QUIC listener (QUIC_LISTEN_ADDR, on by default -- see the root
# .env.example) is bound to a non-default port; the QUIC *host* always
# comes from EXPO_PUBLIC_API_URL above, never a separate host env var.
# Defaults to 4433, matching QUIC_LISTEN_ADDR's own default.
# EXPO_PUBLIC_QUIC_PORT=4433
