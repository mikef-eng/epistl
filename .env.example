# Copy this file to .env and adjust if you need different values.
# .env is gitignored; .env.example is the checked-in template.
#
# Everything here is a LOCAL DEV DEFAULT for the throwaway docker-compose
# Postgres instance. Never reuse these values, or anything shaped like
# them, outside local development.

# Consumed by docker-compose.yml to configure the local Postgres container
# (docker compose reads .env from this same directory automatically).
POSTGRES_USER=epistl
POSTGRES_PASSWORD=epistl
POSTGRES_DB=epistl

# Consumed directly by the API (apps/api/src/db.rs). Must point at the
# Postgres container above. Export before running `moon run api:*`:
#   set -o allexport; source .env; set +o allexport
DATABASE_URL=postgres://epistl:epistl@localhost:5432/epistl

# Consumed directly by the API (apps/api/src/main.rs) for better-auth
# session signing. Must be at least 32 bytes; any random string works
# for local dev since sessions are only ever checked against your own
# local database.
AUTH_SECRET=change-me-to-any-random-32-plus-character-string

# Consumed directly by the API (apps/api/src/nats.rs) to connect to NATS
# at startup. Must point at the docker-compose `nats` service above.
NATS_URL=nats://localhost:4222

# Consumed directly by the API (apps/api/src/nats.rs) to configure the
# EPISTL_OFFLINE_MESSAGES JetStream stream at startup: how long a message
# queued for an offline recipient may sit before JetStream auto-expires
# it, in seconds. Optional -- defaults to 86400 (24 hours) if unset. See
# docs/decisions/0008-jetstream-transient-offline-queue.md.
OFFLINE_QUEUE_MAX_AGE_SECS=86400

# Consumed directly by the API (apps/api/src/quic.rs) to control the real
# QUIC listener that runs alongside the HTTP/WS server. On by default
# (issue #114): unset means it binds 0.0.0.0:4433 (the default QUIC is now
# the primary transport, with WS as its fallback -- see README.md's
# Transport row). Optionally set it to a different bind address to
# override, or to "off" to disable the listener entirely. When running, it
# speaks the same authenticated relay protocol as /ws, sharing the same
# connection registry, over a freshly-generated in-memory self-signed dev
# TLS cert -- see docs/decisions/0011-quic-dev-cert-trust-remains-dev-only.md.
# QUIC_LISTEN_ADDR=0.0.0.0:4433
