# Copy this file to .env and adjust if you need different values.
# .env is gitignored; .env.example is the checked-in template.
#
# Everything here is a LOCAL DEV DEFAULT for the throwaway docker-compose
# Postgres instance. Never reuse these values, or anything shaped like
# them, outside local development.

# Consumed by docker-compose.yml to configure the local Postgres container
# (docker compose reads .env from this same directory automatically).
POSTGRES_USER=epistl
POSTGRES_PASSWORD=epistl
POSTGRES_DB=epistl

# Per-worktree Postgres DB + NATS stream isolation (issue #219).
# Optional. When set to a non-empty value, `moon run api:migrate` and
# `moon run api:test` use a derived DB named `<base_db>_wt_<slug>` instead
# of the base DB from DATABASE_URL. On the primary checkout this should be
# left unset; it's set automatically when running inside a Claude Code
# `.claude/worktrees/<name>` worktree (detected from git rev-parse output).
# Only set this manually to force isolation without a git worktree, e.g.:
#   EPISTL_WORKTREE_SLUG=my-local-fork
# The role at POSTGRES_USER must have CREATEDB: ALTER ROLE epistl CREATEDB;
# EPISTL_WORKTREE_SLUG=

# Consumed directly by the API (apps/api/src/db.rs). Must point at the
# Postgres container above. Export before running `moon run api:*`:
#   set -o allexport; source .env; set +o allexport
DATABASE_URL=postgres://epistl:epistl@localhost:5432/epistl

# Consumed directly by the API (apps/api/src/main.rs) for better-auth
# session signing. Must be at least 32 bytes; any random string works
# for local dev since sessions are only ever checked against your own
# local database.
AUTH_SECRET=change-me-to-any-random-32-plus-character-string

# Consumed directly by the API (apps/api/src/nats.rs) to connect to NATS
# at startup. Must point at the docker-compose `nats` service above.
NATS_URL=nats://localhost:4222

# Consumed directly by the API (apps/api/src/nats.rs) to configure the
# EPISTL_OFFLINE_MESSAGES JetStream stream at startup: how long a message
# queued for an offline recipient may sit before JetStream auto-expires
# it, in seconds. Optional -- defaults to 86400 (24 hours) if unset. See
# docs/decisions/0008-jetstream-transient-offline-queue.md.
OFFLINE_QUEUE_MAX_AGE_SECS=86400

# Consumed directly by the API (apps/api/src/quic.rs) to control the real
# QUIC listener that runs alongside the HTTP/WS server. On by default
# (issue #114): unset means it binds 0.0.0.0:4433 (the default QUIC is now
# the primary transport, with WS as its fallback -- see README.md's
# Transport row). Optionally set it to a different bind address to
# override, or to "off" to disable the listener entirely. When running, it
# speaks the same authenticated relay protocol as /ws, sharing the same
# connection registry, over a freshly-generated in-memory self-signed dev
# TLS cert -- see docs/decisions/0011-quic-dev-cert-trust-remains-dev-only.md.
# QUIC_LISTEN_ADDR=0.0.0.0:4433

# Consumed by docker/seaweedfs-s3-config.json to configure the local
# SeaweedFS S3 gateway's one static identity (SeaweedFS's S3 gateway takes
# credentials from that JSON file, not from simple root-user/password env
# vars the way MinIO worked). LOCAL DEV ONLY -- never reuse these values,
# or anything shaped like them, outside local development. IMPORTANT:
# changing either value here requires updating
# docker/seaweedfs-s3-config.json to match -- nothing wires these env vars
# into that JSON file automatically.
SEAWEEDFS_S3_ACCESS_KEY=epistl
SEAWEEDFS_S3_SECRET_KEY=epistl-seaweedfs-dev-secret

# Consumed directly by the API (future avatar upload/serving endpoint) to
# talk to the SeaweedFS container above for admin operations and to
# actually sign presigned URLs. This must be the docker-compose service
# hostname, since the API itself runs inside the same docker-compose
# network (or, when run outside Docker via `moon run api:dev`, `localhost`
# reaches the published port the same way).
SEAWEEDFS_INTERNAL_ENDPOINT=http://seaweedfs:8333

# Consumed directly by the API (future avatar upload/serving endpoint) as
# the hostname that must appear *inside* any presigned URL handed to the
# mobile client. This has to be a host-reachable address (not the
# `seaweedfs` docker-compose service name above) because the mobile client
# cannot resolve docker-compose internal service names -- a well-known
# gotcha carried over from MinIO: the endpoint used to *sign* a presigned
# URL and the endpoint a client uses to *reach* it are not always the same
# thing. See docs/decisions/0018-seaweedfs-object-storage-for-avatars.md.
SEAWEEDFS_PUBLIC_ENDPOINT=http://localhost:8333

# Consumed directly by the API (future avatar upload/serving endpoint) as
# the SeaweedFS bucket name avatars are stored in. This bucket is created
# automatically by the `seaweedfs` docker-compose service's `S3_BUCKET` env
# var at container startup -- no API-side bucket-creation logic needed.
AVATAR_BUCKET_NAME=avatars
